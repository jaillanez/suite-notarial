# Copiar a `.env` y ajustar. Nunca commitear `.env`.
ENVIRONMENT=development

# Rol de la aplicación: DML, sin privilegios de dueño.
DATABASE_URL=postgresql+asyncpg://suite_app:suite_app_dev@localhost:5432/suite_notarial
# Rol dueño del esquema: solo para migraciones (make migrate).
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://suite_owner:suite_owner_dev@localhost:5432/suite_notarial
# SEC-04: todos los enlaces de mail se arman desde esta URL.
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# Clave AES-256 (32 bytes en base64) para cifrar secretos en reposo, como las semillas TOTP.
# Generar con: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=cambiar-por-una-clave-base64-de-32-bytes
# 2FA obligatorio para ADMIN/CAJA/TESORERIA/AUDITOR. Solo se puede poner en false en
# development/test, para probar sin reactivar el 2FA tras cada `make reset-dev`.
MFA_ENFORCED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MFA_PENDING_TTL_MIN=5

# En desarrollo sobre http://localhost se usa false; en producción siempre true.
COOKIE_SECURE=false
COOKIE_DOMAIN=

SMTP_HOST=localhost
SMTP_PORT=1025
# none (solo dev/test con Mailpit) | starttls | tls. Fuera de desarrollo se exige TLS.
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-responder@cajanotarial.local
PASSWORD_RESET_TTL_MIN=30

UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=10
# Tamaño máximo de los documentos oficiales que se publican en el sitio (PDF).
CMS_MAX_DOC_MB=25

# IA asistencial (OCR local; requiere `brew install tesseract tesseract-lang`)
IA_TESSERACT_CMD=tesseract
IA_OCR_IDIOMAS=spa+eng
IA_OCR_TIMEOUT_S=30
IA_OCR_CONCURRENCIA=2

LOG_LEVEL=INFO

# Datos impresos en la boleta de pago. Completar con los datos oficiales de la Caja solo en el
# `.env` de cada entorno; sin ellos la boleta indica "Datos bancarios a confirmar".
CAJA_NOMBRE=Caja Notarial de San Juan
CAJA_CUIT=
CAJA_DOMICILIO=
CAJA_CONTACTO=
BANCO_NOMBRE=
BANCO_CUENTA=
BANCO_CBU=
BANCO_ALIAS=

# Solo desarrollo: contraseña de los usuarios de demostración que crea `make seed-dev`.
# Debe cumplir la política (10+ caracteres, mayúscula, minúscula, número y símbolo).
DEV_SEED_PASSWORD=
