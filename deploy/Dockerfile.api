# API de la Suite Notarial (FastAPI + Uvicorn). Contexto de build: raíz del repo.
FROM python:3.12-slim-bookworm

# Librerías nativas: libmagic (validación por magic bytes), pango (weasyprint, PDF de
# boletas), tesseract con español (OCR local de la IA asistencial) y fuentes para los PDF.
# Cliente de PostgreSQL 16 (pg_dump/pg_restore) para el respaldo y la reversa de la migración:
# tiene que ser de la misma versión que el servidor (postgres:16 en compose.server.yml), y
# bookworm solo trae la 15, así que sale del repositorio oficial de PostgreSQL (PGDG). La clave
# se toma solo por su huella publicada (se exporta esa clave y ninguna otra); el repositorio queda limitado a los
# paquetes del cliente (prioridad -1 para el resto) y se borra al terminar: la imagen final no
# conserva ninguna fuente ni clave de terceros.
ARG PGDG_FPR=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libmagic1 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libfontconfig1 \
      tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
      fonts-dejavu-core fonts-liberation2 \
      ca-certificates curl gnupg \
 && curl -fsSL --proto '=https' --tlsv1.2 https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /tmp/pgdg.asc \
 && gpg --batch --no-default-keyring --keyring /tmp/pgdg.kbx --import /tmp/pgdg.asc \
 && gpg --batch --no-default-keyring --keyring /tmp/pgdg.kbx --export "${PGDG_FPR}" \
      > /usr/share/keyrings/pgdg.gpg \
 && test -s /usr/share/keyrings/pgdg.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && printf 'Package: *\nPin: release o=apt.postgresql.org\nPin-Priority: -1\n\nPackage: postgresql-client-16 postgresql-client-common libpq5\nPin: release o=apt.postgresql.org\nPin-Priority: 600\n' \
      > /etc/apt/preferences.d/pgdg \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-16 \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -f /etc/apt/sources.list.d/pgdg.list /etc/apt/preferences.d/pgdg /usr/share/keyrings/pgdg.gpg \
 && rm -rf /var/lib/apt/lists/* /root/.gnupg /tmp/pgdg.asc /tmp/pgdg.kbx*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# Dependencias con versión y hash fijos (backend/requirements.lock): la imagen instala
# exactamente lo que probó el CI. El paquete propio va después y sin dependencias.
COPY backend/pyproject.toml backend/requirements.lock ./
RUN pip install --require-hashes -r requirements.lock
COPY backend/app ./app
RUN pip install --no-deps .
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic

# Usuario sin privilegios; los comprobantes y documentos viven en un volumen propio.
RUN useradd --system --uid 10001 --home-dir /app suite \
 && mkdir -p /data/uploads && chown suite /data/uploads
USER suite

EXPOSE 8000
# Solo se confía en las cabeceras de proxy del nginx de la Suite (IP fija en la red interna,
# ver compose.server.yml); de cualquier otro origen se ignoran.
ENV TRUSTED_PROXY_IP=10.77.88.10
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips \"$TRUSTED_PROXY_IP\""]
