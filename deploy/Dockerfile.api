# API de la Suite Notarial (FastAPI + Uvicorn). Contexto de build: raíz del repo.
FROM python:3.12-slim-bookworm

# Librerías nativas: libmagic (validación por magic bytes), pango (weasyprint, PDF de
# boletas), tesseract con español (OCR local de la IA asistencial) y fuentes para los PDF.
# Cliente de PostgreSQL 16 (pg_dump/pg_restore) para el respaldo y la reversa de la migración:
# tiene que ser de la misma versión que el servidor (postgres:16 en compose.server.yml), y
# bookworm solo trae la 15, así que sale del repositorio oficial de PostgreSQL (PGDG).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/pgdg.asc \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libmagic1 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libfontconfig1 \
      tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng \
      fonts-dejavu-core fonts-liberation2 \
      postgresql-client-16 \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY backend/pyproject.toml ./
COPY backend/app ./app
RUN pip install .
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic

# Usuario sin privilegios; los comprobantes y documentos viven en un volumen propio.
RUN useradd --system --uid 10001 --home-dir /app suite \
 && mkdir -p /data/uploads && chown suite /data/uploads
USER suite

EXPOSE 8000
# Solo se confía en las cabeceras de proxy del nginx de la Suite (IP fija en la red interna,
# ver compose.server.yml); de cualquier otro origen se ignoran.
ENV TRUSTED_PROXY_IP=10.77.88.10
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips \"$TRUSTED_PROXY_IP\""]
