# Configuración de la Suite Notarial en el servidor. Copiar a deploy/.env.server (nunca se
# commitea) y completar. Las claves se cargan en el servidor, nunca por chat ni en el repo.
# deploy/generar-claves.sh completa las contraseñas y claves internas.

# staging = entorno de prueba (datos de ejemplo); production = la Caja en operación.
ENVIRONMENT=staging

# ── Base de datos (contenedor propio; ver compose.server.yml) ──
POSTGRES_SUPERUSER_PASSWORD=
SUITE_OWNER_PASSWORD=
SUITE_APP_PASSWORD=

# ── Dominio ──  SEC-04: todos los enlaces de los mails salen de acá.
PUBLIC_WEB_URL=https://DOMINIO-A-DEFINIR
CORS_ORIGINS=["https://DOMINIO-A-DEFINIR"]
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ── Sesión y cifrado (generar-claves.sh) ──
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
DATA_ENCRYPTION_KEY=
MFA_ENFORCED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MFA_PENDING_TTL_MIN=5

# ── Correo (cuenta SMTP real; fuera de desarrollo se exige TLS) ──
# Sin cuenta todavía: la Suite funciona, pero no salen los mails (recuperar contraseña).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MIN=30

MAX_UPLOAD_MB=10
CMS_MAX_DOC_MB=25

# ── IA asistencial ──
IA_TESSERACT_CMD=tesseract
IA_OCR_IDIOMAS=spa+eng
IA_OCR_TIMEOUT_S=30
IA_OCR_CONCURRENCIA=2
# deepseek solo con la autorización de la Caja (registrada el 27/10/2026) y su clave.
IA_VISION_PROVEEDOR=local
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
IA_VISION_TIMEOUT_S=90
IA_INDICE_MAX_FOTOS=6

# ── Mercado Pago (si está vacío, no se ofrece el pago) ──
# Fuera de desarrollo, con token también hace falta la clave secreta de las notificaciones.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

LOG_LEVEL=INFO

# ── Datos impresos en la boleta (oficiales de la Caja) ──
CAJA_NOMBRE=Caja Notarial de San Juan
CAJA_CUIT=
CAJA_DOMICILIO=
CAJA_CONTACTO=
BANCO_NOMBRE=
BANCO_CUENTA=
BANCO_CBU=
BANCO_ALIAS=
# Contacto público del sitio institucional.
CAJA_TELEFONO=
CAJA_EMAIL=

# Solo en el servidor de prueba (staging): contraseña de los usuarios de demostración que crea
# `seed-dev` (la genera generar-claves.sh; no se usa para entrar, solo como autores de los datos).
DEV_SEED_PASSWORD=

# Puerto local de verificación (solo 127.0.0.1) y red del Caddy compartido.
WEB_BIND_PORT=8686
EDGE_NETWORK=suite-turnos_edge
