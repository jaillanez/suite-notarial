# nginx de la Suite Notarial (dentro del contenedor web). El TLS y el dominio los resuelve el
# Caddy compartido del servidor; acá solo se sirve la SPA y se pasa /api a la API interna.
# Plantilla: la imagen oficial reemplaza ${EDGE_SUBNET} al arrancar.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Fotos del índice (hasta 6), comprobantes (10 MB) y documentos del sitio (25 MB).
    client_max_body_size 80m;

    # IP real del cliente (auditoría, bloqueo de ingresos): solo se toma la que informa un
    # proxy de la red del Caddy compartido; cualquier otro origen ve ignorada su cabecera.
    set_real_ip_from ${EDGE_SUBNET};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Un único valor, ya resuelto arriba: la API confía solo en este nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # La lectura de fotos con IA externa puede tardar hasta 90 s.
        proxy_read_timeout 150s;
        proxy_request_buffering off;
    }

    # Archivos con hash en el nombre: se cachean para siempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Rutas de la SPA: siempre index.html, sin cache para que cada deploy se vea al instante.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri /index.html;
    }
}
